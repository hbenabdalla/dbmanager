{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DBManager chart values",
  "type": "object",
  "properties": {
    "openshift": { "type": "boolean" },
    "image": {
      "type": "object",
      "properties": {
        "backend": { "$ref": "#/definitions/image" },
        "frontend": { "$ref": "#/definitions/image" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "masterKey": { "type": "string", "pattern": "^$|^[A-Za-z0-9+/]{43}=$" },
        "bootstrapAdminPassword": { "type": "string" },
        "databaseUrl": { "type": "string", "pattern": "^$|^postgresql\\+asyncpg://" },
        "postgresPassword": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$" },
        "timeseriesPassword": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "env": { "enum": ["production", "development", "test"] },
        "publicBaseUrl": { "type": "string", "pattern": "^https?://" },
        "cookieSecure": { "type": "boolean" },
        "trustedProxies": { "type": "string" },
        "collectorConcurrency": { "type": "integer", "minimum": 1 },
        "timeseriesRetention": { "type": "string", "pattern": "^[0-9]+[hdwy]$" },
        "extraEnv": { "type": "object", "propertyNames": { "pattern": "^DBM_[A-Z0-9_]+$" }, "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "api": { "$ref": "#/definitions/workload" },
    "worker": { "$ref": "#/definitions/workload" },
    "frontend": { "$ref": "#/definitions/workload" },
    "postgresql": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "properties": { "mode": { "enum": ["", "disable", "prefer", "require", "verify-ca", "verify-full"] } }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "host": { "type": "string" } }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "properties": { "replicas": { "type": "integer", "minimum": 0 } }
    }
  }
}
