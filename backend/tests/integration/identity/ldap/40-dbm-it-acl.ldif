# Read access for DB Manager's service account (test directory only). The osixia image's default
# ACLs let an account read only its own entry, so the service bind succeeded but every user and
# group search returned nothing. A real directory needs the same: the bind DN configured in
# DB Manager must be able to search users and groups (see docs/administration/ldap.md).
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=example,dc=org" write by anonymous auth by * none
olcAccess: {1}to * by self read by dn="cn=admin,dc=example,dc=org" write by dn="uid=svc-dbm,ou=people,dc=example,dc=org" read by * none
