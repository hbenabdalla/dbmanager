# DB Manager — environment configuration.
# Create .env with generated secrets:  scripts\init-env.ps1 (Windows) or ./scripts/init-env.sh
# (or copy this file to .env and replace every CHANGE_ME value by hand). Never commit .env.

# --- Application database (container database-manager-postgres) -----------------------
POSTGRES_DB=dbmanager
POSTGRES_USER=dbmanager
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# --- Secret encryption -------------------------------------------------------------------
# 32 random bytes, base64 (44 characters ending in "="). Generate with:
#   PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Python:     python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes stored target credentials unrecoverable. Back it up separately.
DBM_MASTER_KEY=CHANGE_ME_base64_32_bytes
DBM_MASTER_KEY_ID=k1
# During key rotation list old keys as id:base64 pairs (comma separated), then run
#   docker compose exec backend python -m app.cli rotate-master-key
DBM_PREVIOUS_MASTER_KEYS=

# --- Monitoring telemetry storage (container database-manager-timeseries) ---------------
# VictoriaMetrics single node. Not published on the host; only the backend reaches it.
DBM_TIMESERIES_USERNAME=dbm
DBM_TIMESERIES_PASSWORD=CHANGE_ME_long_random_password
# How long metric history is kept (VictoriaMetrics -retentionPeriod: 30d, 90d, 1y, ...).
# Changing it requires: docker compose up -d timeseries
DBM_TIMESERIES_RETENTION=90d
DBM_TIMESERIES_CPUS=2
DBM_TIMESERIES_MEMORY=2g
# Batch writer: samples per write request and maximum seconds between writes.
DBM_METRIC_BATCH_SIZE=2000
DBM_METRIC_FLUSH_INTERVAL=5
# Samples buffered in memory while the time-series database is unreachable (oldest dropped beyond).
DBM_METRIC_BUFFER_MAX=200000
# Transition aid: also write metric history to the legacy PostgreSQL tables.
DBM_METRICS_PG_DUAL_WRITE=false

# --- First administrator (created only when the user table is empty) --------------------
DBM_BOOTSTRAP_ADMIN_USERNAME=admin
# >= 12 chars with three of: lowercase, uppercase, digit, symbol
DBM_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME-Admin-2026!

# --- Demo / simulation data -------------------------------------------------------------
# No demo data is created at startup. A Platform Administrator can generate (and later
# remove) a clearly labelled simulated fleet under Platform -> Simulation.

# Optional: creates a dbm_monitor role (pg_monitor) in the application PostgreSQL so it can be
# registered as a real target at host "postgres", port 5432, database "dbmanager".
DBM_SAMPLE_MONITOR_PASSWORD=CHANGE_ME-Monitor-2026!

# --- Web ------------------------------------------------------------------------------
DBM_HTTP_BIND=127.0.0.1
DBM_HTTP_PORT=8080
DBM_PUBLIC_BASE_URL=http://localhost:8080
# Keep true behind HTTPS. Browsers accept Secure cookies on http://localhost; set false only
# when testing over plain HTTP on another host name.
DBM_COOKIE_SECURE=true

# --- Runtime --------------------------------------------------------------------------
DBM_ENV=production
DBM_PROCESS_ROLE=all
DBM_LOG_LEVEL=INFO
DBM_COLLECTOR_CONCURRENCY=16
# Retention of the legacy PostgreSQL metric tables (only used during the migration period).
DBM_METRICS_RETENTION_DAYS=35

# Build the backend without Microsoft ODBC Driver 18 when packages.microsoft.com is unreachable.
# Default false: the build fails loudly instead of shipping an image without SQL Server support.
DBM_MSODBC_OPTIONAL=false

# --- product information (Platform -> About, Help menu) ----------------------------------------
# Documentation link; leave empty until the Read the Docs project URL is known (the entry is hidden)
DBM_DOCUMENTATION_URL=
DBM_GITHUB_URL=https://github.com/hbenabdalla/dbmanager
# empty = the ROADMAP.md file in the GitHub repository
DBM_ROADMAP_URL=
# License shown on the About page; empty = the project license (Apache-2.0)
DBM_LICENSE=
# build metadata baked into the images (e.g. DBM_GIT_COMMIT=$(git rev-parse --short HEAD))
DBM_BUILD_VERSION=
DBM_GIT_COMMIT=
DBM_BUILD_DATE=

# --- alerting & notifications --------------------------------------------------------------------
DBM_ALERT_EVALUATION_SECONDS=60
# webhook receivers on private/loopback addresses are refused unless this is true (SSRF guard)
DBM_WEBHOOK_ALLOW_PRIVATE=false
DBM_WEBHOOK_TIMEOUT_SECONDS=10
# default SMTP server for email channels (a channel can override host/port/user/password)
DBM_SMTP_HOST=
DBM_SMTP_PORT=587
DBM_SMTP_USER=
DBM_SMTP_PASSWORD=
DBM_SMTP_FROM=
DBM_SMTP_STARTTLS=true
