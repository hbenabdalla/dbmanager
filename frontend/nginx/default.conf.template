# Rendered by the nginx image entrypoint (envsubst) — only ${BACKEND_URL} is substituted.
server_tokens off;

map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 2m;

  # Security headers for the SPA. style-src needs 'unsafe-inline' for component style attributes
  # and the SQL editor; scripts are restricted to same-origin bundles.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 180s;
    proxy_buffering off;   # stream CSV exports
  }

  location = /healthz { proxy_pass ${BACKEND_URL}/healthz; access_log off; }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    # add_header here replaces the server-level headers: keep nosniff on static files
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # web app manifest (favicon / app icon metadata); not every nginx mime.types maps .webmanifest
  location = /site.webmanifest {
    types { }
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri /index.html;
  }
}
